# ─── Database (SQLite, zero-config) ────────────────
DATABASE_URL="file:./dev.db"

# ─── NextAuth ──────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Troque por uma string aleatória de >= 32 chars em produção
NEXTAUTH_SECRET="change-me-in-production-min-32-characters-long"

# ─── Integrações opcionais (template usa stubs por padrão) ───
# Defina ENABLE_REAL_INTEGRATIONS=true e preencha as chaves para
# ativar provedores reais no lugar dos stubs em lib/stubs.ts.
# ENABLE_REAL_INTEGRATIONS=false

# Email (Resend)
# RESEND_API_KEY=

# Payments (Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Alertas (Telegram)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# OTA externa (exemplo)
# GETYOURGUIDE_API_KEY=
# GETYOURGUIDE_PARTNER_ID=

# Monitoramento (Sentry — opt-in, não inicializa sem DSN)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# Agendador (cron jobs internos)
# ENABLE_CRON=false

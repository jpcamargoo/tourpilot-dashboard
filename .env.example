# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vibrant_tours?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# Software de Gestão (API ou CSV path)
GESTAO_API_URL="https://api.seu-software.com"
GESTAO_API_KEY="your-api-key"
# Ou para CSV local:
# GESTAO_CSV_PATH="./data/reservas.csv"

# Google Places API (para reviews)
GOOGLE_PLACES_API_KEY="your-google-api-key"

# TripAdvisor (se disponível)
TRIPADVISOR_API_KEY="your-tripadvisor-key"

# Backup
BACKUP_PATH="./backups"

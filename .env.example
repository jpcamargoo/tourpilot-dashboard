# ===================================
# 🔐 VARIÁVEIS DE AMBIENTE - VIBRANT
# ===================================

# ===================================
# BANCO DE DADOS
# ===================================
# Desenvolvimento (SQLite) - Padrão
DATABASE_URL="file:./dev.db"

# Produção (PostgreSQL - Supabase)
# Descomente e configure para staging/produção:
# DATABASE_URL="postgresql://postgres:[SENHA]@[HOST]:5432/postgres?pgbouncer=true&connection_limit=1"

# ===================================
# AUTENTICAÇÃO (NextAuth.js)
# ===================================
# Gere um secret em: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="seu_secret_aqui_minimo_32_caracteres"

# URL da aplicação (ajuste conforme ambiente)
# Desenvolvimento: http://localhost:3000
# Staging: https://vibrant-tours-staging.vercel.app
# Produção: https://dashboard.vibrantcitytours.com
NEXTAUTH_URL="http://localhost:3000"

# ===================================
# INTEGRAÇÕES EXTERNAS (Opcional)
# ===================================
# GetYourGuide - IDs dos tours para scraping de reviews (separados por vírgula)
# GETYOURGUIDE_TOUR_IDS="12345,67890"
# GETYOURGUIDE_API_KEY="sua_api_key_aqui"
# GETYOURGUIDE_PARTNER_ID="seu_partner_id"

# Telegram Bot
# TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
# TELEGRAM_CHAT_ID="-1001234567890"

# Google Places API (scraping de reviews)
# GOOGLE_PLACES_API_KEY="sua_google_api_key"

# TripAdvisor API (se disponível)
# TRIPADVISOR_API_KEY="sua_tripadvisor_key"

# Email SMTP (relatórios e notificações)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="seu_email@gmail.com"
# SMTP_PASS="sua_senha_app"

# ===================================
# ETL E IMPORTAÇÃO
# ===================================
# Software de Gestão (API ou CSV)
# GESTAO_API_URL="https://api.seu-software.com"
# GESTAO_API_KEY="your-api-key"
# GESTAO_CSV_PATH="./data/reservas.csv"

# ===================================
# BACKUP E ARMAZENAMENTO
# ===================================
# BACKUP_PATH="./backups"

# ===================================
# MONITORAMENTO (Opcional)
# ===================================
# Sentry - Rastreamento de erros em produção
# NEXT_PUBLIC_SENTRY_DSN="https://[key]@[org].ingest.sentry.io/[project]"
# SENTRY_ORG="sua-organizacao"
# SENTRY_PROJECT="vibrant-city-tours"

# Google Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ===================================
# CONFIGURAÇÕES AVANÇADAS
# ===================================
# Ambiente (development | staging | production)
NODE_ENV="development"

# Rate Limiting
# RATE_LIMIT_ENABLED="true"
# RATE_LIMIT_MAX_REQUESTS="20"
# RATE_LIMIT_WINDOW_MS="60000"
